# Porta em que o servidor Fastify vai escutar
PORT=3001

# Conexão com o PostgreSQL (ajuste usuário, senha e nome do banco)
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/todo_list

# Chave secreta usada para assinar e validar o JWT
# Em produção, troque por uma string longa e aleatória
JWT_SECRET=troque_esta_chave_secreta
